rules_version = '2';

// Cada usuário só enxerga os próprios dados, em users/{uid}/...
// As Cloud Functions usam o Admin SDK e não passam por estas regras.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function optionalString(data, field, maxSize) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].size() <= maxSize);
    }

    function isValidTransaction(data) {
      return data.kind in ['expense', 'income']
        && data.status in ['paid', 'pending']
        && data.amount_cents is int && data.amount_cents >= 0
        && data.description is string && data.description.size() > 0 && data.description.size() <= 255
        && data.category is string && data.category.size() > 0 && data.category.size() <= 60
        && isIsoDate(data.occurred_on)
        && (!('due_date' in data) || data.due_date == null || isIsoDate(data.due_date))
        && data.needs_review is bool
        && optionalString(data, 'counterparty', 255)
        && optionalString(data, 'payment_method', 40)
        && optionalString(data, 'account', 100)
        && optionalString(data, 'notes', 5000);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['owner_documents', 'updated_at'])
        && (!('owner_documents' in request.resource.data) || request.resource.data.owner_documents is list);

      match /transactions/{txId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidTransaction(request.resource.data);
        // Origem e identificador externo são definidos pelo servidor.
        allow update: if isOwner(uid) && isValidTransaction(request.resource.data)
          && request.resource.data.get('external_id', null) == resource.data.get('external_id', null)
          && request.resource.data.get('source', null) == resource.data.get('source', null);
      }

      // Metadados dos arquivos enviados: escritos só pelas Cloud Functions.
      match /documents/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
