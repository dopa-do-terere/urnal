# Chave da OpenRouter (https://openrouter.ai/keys). Sem ela, só XML de NF-e e
# linha digitável de boleto são processados (parsers locais).
OPENROUTER_API_KEY=

# Modelo usado para ler prints, fotos, PDFs e texto livre. Precisa aceitar imagem.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Pasta onde ficam o banco SQLite e os arquivos enviados.
DATA_DIR=data

# Opcional: URL do banco (padrão: sqlite em DATA_DIR/financas.db).
# DATABASE_URL=sqlite:///data/financas.db

# Seus CPF/CNPJ, separados por vírgula. Usado para saber se uma NF-e é
# receita (você é o emitente) ou despesa (você é o destinatário).
OWNER_DOCUMENTS=

# Tamanho máximo por arquivo enviado, em MB.
MAX_UPLOAD_MB=20
